
local clientChecks=0
local function check(ok,message) assert(ok,message) clientChecks+=1 end
local hud=pg:FindFirstChild('FactoryEventHud')
check(hud and hud.ZIndexBehavior==Enum.ZIndexBehavior.Sibling,'event ScreenGui uses Sibling')
local panel=hud:FindFirstChild('EventPanel')
local main=panel:FindFirstChild('JoinOrPulse') local leave=panel:FindFirstChild('Leave')
local skip=hud:FindFirstChild('SkipFinale')
local p={roundId='client-round',phase='Announce',started=clock,ends=clock+20,hp=0,maxHp=0,participants={}}
local function receive()
	remotes.FactoryEventState.OnClientEvent:Fire(p)
	services.RunService.RenderStepped:Fire(.016)
end
receive()
check(panel.Visible and main.Visible and main.Text=='JOIN EVENT','announcement offers join')
main.Activated:Fire()
check(calls[#calls][1]=='Join','join button sends only intent')
p.you={points=15,grade=2,count=10,active=0,hits=0,present=true,pulseReady=0,eligible=false,reward=0}
p.participants={{userId=2,plotIndex=2,origin=CFrame.new(300,0,0),points=15,grade=2,dominant='Uncommon',count=10,present=true}}
p.phase='Assemble' p.ends=clock+6 receive()
check(not main.Visible and leave.Visible,'assembly keeps leave available')
p.phase='Active' p.started=clock p.ends=clock+180 p.hp=60 p.maxHp=100 receive()
check(main.Visible and main.Text=='OVERDRIVE · NOW!','active beat offers overdrive')
main.Activated:Fire() check(calls[#calls][1]=='Pulse','overdrive sends no damage value')
p.you.present=false receive()
main.Activated:Fire() check(calls[#calls][1]=='Plot','away button uses existing server travel')
p.you.present=true p.phase='Finale' p.started=clock p.ends=clock+7 receive()
check(camera.CameraType==Enum.CameraType.Scriptable and skip.Visible,'participant gets optional finale view')
skip.Activated:Fire()
check(camera.CameraType==Enum.CameraType.Custom and camera.FieldOfView==72 and camera.CFrame==savedCamera,'skip restores original camera exactly')
receive()
check(camera.CameraType==Enum.CameraType.Custom,'repeated server packets do not reopen skipped view')
p.roundId='upgrade-view' receive()
check(camera.CameraType==Enum.CameraType.Scriptable,'upgrade overlap starts from event view')
remotes.PlotUpgraded.OnClientEvent:Fire({level=1})
check(camera.CameraType==Enum.CameraType.Custom,'confirmed plot upgrade releases event camera before its cutscene')
p.roundId='death-view' receive()
check(camera.CameraType==Enum.CameraType.Scriptable,'next event can show finale again')
b.Character:FindFirstChildOfClass('Humanoid').Health=0 services.RunService.RenderStepped:Fire(.016)
check(camera.CameraType==Enum.CameraType.Custom and not skip.Visible,'death releases finale camera')
b.Character:FindFirstChildOfClass('Humanoid').Health=100
p.roundId='spectator' p.you=nil receive()
check(camera.CameraType==Enum.CameraType.Custom,'spectators keep normal camera')
p.phase='Idle' receive()
check(not panel.Visible,'HUD hides after event')
clientScript.Destroying:Fire()
check(hud.Parent==nil and services.SoundService:FindFirstChild('FactoryEventImpact')==nil,'script cleanup removes HUD and pooled sound')
check(#warnings==0,'actual LocalScript executes without mocked runtime warnings')
print('PASS|Actual HUD/actions/camera lifecycle|'..clientChecks)
